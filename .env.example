# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration (Supabase PostgreSQL)
# Connection pooling (for serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct connection (for migrations)
DIRECT_URL=postgresql://postgres.your-project:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# External API Configuration (optional)
EXTERNAL_SALES_API_URL=https://your-api.com/api/v1
EXTERNAL_API_TOKEN=your-api-token
EXTERNAL_API_TIMEOUT=30000

# Cache Configuration (optional)
REDIS_URL=redis://localhost:6379

# Application URL 
NEXT_PUBLIC_APP_URL=http://localhost:3000 
